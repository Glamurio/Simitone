<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Geometry tests for the routing planner (VMShimmyPlanner). Deliberately dependency-free: no test
    framework packages, Program.cs returns the number of failed tests as the exit code.
    Run with dotnet run (project Tests/Simitone.Routing.Tests, configuration Release).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Client\Simitone\Simitone.Windows\GameLocator\PathArgument.cs" Link="PathArgument.cs" />
    <Compile Include="..\..\Client\Simitone\Simitone.Client\UI\Utils\ZoomSteps.cs" Link="ZoomSteps.cs" />
    <Compile Include="..\..\Client\Simitone\Simitone.Client\Utils\BuildUndoStack.cs" Link="BuildUndoStack.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FreeSO\TSOClient\tso.simantics\FSO.SimAntics.csproj" />
  </ItemGroup>

</Project>
