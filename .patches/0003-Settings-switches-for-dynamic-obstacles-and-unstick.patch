From 562e09fc8f7f9c5f9706a786297f58439be33678 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 18:08:16 +0200
Subject: [PATCH 3/4] Settings: switches for dynamic obstacles and unstick

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019q6m8f542cVUMKg755aFtZ
---
 Client/Simitone/Simitone.Client/Utils/SimitoneSettings.cs   | 6 ++++++
 .../Simitone.Client/Utils/SimitoneSettingsRegistry.cs       | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/Client/Simitone/Simitone.Client/Utils/SimitoneSettings.cs b/Client/Simitone/Simitone.Client/Utils/SimitoneSettings.cs
index ee47d6b..aa984e7 100644
--- a/Client/Simitone/Simitone.Client/Utils/SimitoneSettings.cs
+++ b/Client/Simitone/Simitone.Client/Utils/SimitoneSettings.cs
@@ -37,6 +37,8 @@ namespace Simitone.Client.Utils
             { "Shimmy", "true" },
             { "RoutingFixes", "true" },
             { "QueueFixes", "true" },
+            { "DynamicObstacles", "true" },
+            { "Unstick", "true" },
 
             //debugging
             { "Diagnostics", "true" },
@@ -62,6 +64,8 @@ namespace Simitone.Client.Utils
         public bool Shimmy { get; set; }
         public bool RoutingFixes { get; set; }
         public bool QueueFixes { get; set; }
+        public bool DynamicObstacles { get; set; }
+        public bool Unstick { get; set; }
 
         public bool Diagnostics { get; set; }
         public bool DrawRoutes { get; set; }
@@ -83,6 +87,8 @@ namespace Simitone.Client.Utils
             VMFeatures.Shimmy = Shimmy;
             VMFeatures.RoutingFixes = RoutingFixes;
             VMFeatures.QueueFixes = QueueFixes;
+            VMFeatures.DynamicObstacles = DynamicObstacles;
+            VMFeatures.Unstick = Unstick;
             VMFeatures.Diagnostics = Diagnostics;
             VMRoutingFrame.DEBUG_DRAW = DrawRoutes;
         }
diff --git a/Client/Simitone/Simitone.Client/Utils/SimitoneSettingsRegistry.cs b/Client/Simitone/Simitone.Client/Utils/SimitoneSettingsRegistry.cs
index 143142e..a2bfabc 100644
--- a/Client/Simitone/Simitone.Client/Utils/SimitoneSettingsRegistry.cs
+++ b/Client/Simitone/Simitone.Client/Utils/SimitoneSettingsRegistry.cs
@@ -109,6 +109,12 @@ namespace Simitone.Client.Utils
             list.Add(Toggle(SIMULATION, "Action queue fixes",
                 "Queued actions for objects pets can use can be cancelled; fixes a freeze when queueing.",
                 () => S.QueueFixes, (v) => { S.QueueFixes = v; SaveS(); }, departure: true));
+            list.Add(Toggle(SIMULATION, "Walk around standing Sims",
+                "Plan around Sims standing still, plan again when objects move, retry a blocked door once.",
+                () => S.DynamicObstacles, (v) => { S.DynamicObstacles = v; SaveS(); }, departure: true));
+            list.Add(Toggle(SIMULATION, "Free stuck Sims",
+                "A Sim squeezed against an object steps out instead of failing every route.",
+                () => S.Unstick, (v) => { S.Unstick = v; SaveS(); }, departure: true));
 
             //--- camera and controls
             list.Add(Toggle(CONTROLS, "Edge scrolling", "Scroll the lot when the mouse touches the screen edge.",
